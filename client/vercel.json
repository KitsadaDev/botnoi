{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://coolcare-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://coolcare-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}

