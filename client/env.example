# Plasom - Server Environment Variables

# Database PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT Secret (เปลี่ยนเป็น random string ยาวๆ ก่อน deploy)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Port ของ server
PORT=4000

# URL ของ Client (สำหรับ CORS)
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"
