// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// Enums
// ===========================

enum TicketStatus {
  SUBMITTED   // ส่งเรื่องแล้ว
  RECEIVED    // รับเรื่องแล้ว
  IN_PROGRESS // ช่างกำลังเข้าซ่อม
  COMPLETED   // เสร็จสิ้น
  CANCELLED   // ยกเลิก
}

enum ServiceType {
  CLEANING     // ล้างแอร์
  REPAIR       // ซ่อมแอร์
  INSTALLATION // ติดตั้ง/ย้ายแอร์
  IT_REPAIR    // ซ่อมอุปกรณ์ไอที (คอม/โน้ตบุ๊ก/การ์ดจอ/เครื่องเกม/ปริ้นเตอร์)
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// ===========================
// Models
// ===========================

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())

  tickets  Ticket[]
  messages Message[]
  projects Project[]
}

model Project {
  id            String   @id @default(cuid())
  name          String   // ชื่อโปรเจกต์ / ชื่อร้านค้า / ธุรกิจ
  slug          String   @unique // รหัส URL เฉพาะโปรเจกต์ เช่น coolcare-bkk
  description   String?  // รายละเอียดธุรกิจ
  businessType  String   @default("AC_AND_IT") // ประเภทธุรกิจ เช่น AC_AND_IT, AC_SERVICE, IT_SUPPORT, GENERAL
  phone         String?  // เบอร์ติดต่อศูนย์บริการของโปรเจกต์
  lineOaId      String?  // LINE Official Account ID
  botnoiBotId   String?  // Bot ID จาก Botnoi Chatbot Platform
  webhookSecret String?  // Secret เฉพาะโปรเจกต์ (optional)
  isActive      Boolean  @default(true)

  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tickets           Ticket[]
  technicians       Technician[]
  chatConversations ChatConversation[]
  reviews           SatisfactionReview[]

  @@index([ownerId])
}

model Technician {
  id          String   @id @default(cuid())
  name        String
  phone       String
  area        String   // พื้นที่รับผิดชอบ
  specialty   String?  // ความเชี่ยวชาญ เช่น แอร์บ้าน, แอร์โรงงาน, ซ่อมคอม/ไอที
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tickets Ticket[]

  @@index([projectId])
}

model Ticket {
  id            String       @id @default(cuid())
  trackingCode  String       @unique  // รหัสติดตาม รูปแบบ CC-YYYYMMDD-XXXX
  service       ServiceType
  brand         String       // ยี่ห้อ/อุปกรณ์ (แอร์หรืออุปกรณ์ไอที)
  symptom       String       // อาการเสีย
  address       String       // ที่อยู่
  lat           Float?       // พิกัด latitude (optional)
  lng           Float?       // พิกัด longitude (optional)
  preferredDate DateTime     // วัน-เวลาที่สะดวก
  note          String?      // หมายเหตุ
  status        TicketStatus @default(SUBMITTED)
  source        String       @default("WEB") // ช่องทางที่แจ้งเข้ามา: WEB, CHATBOT, VOICEBOT, LINE

  // ข้อมูลผู้แจ้ง (ลูกค้าอาจไม่ได้ล็อกอิน)
  customerName  String
  customerPhone String

  // ความสัมพันธ์ optional
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  technicianId  String?
  technician    Technician?  @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // ตารางลูก
  images            TicketImage[]
  statusLogs        StatusLog[]
  messages          Message[]
  review            SatisfactionReview?
  chatConversations ChatConversation[]

  // Index สำหรับ query ที่ใช้บ่อย
  @@index([customerPhone])
  @@index([status])
  @@index([projectId])
}

model TicketImage {
  id       String @id @default(cuid())
  url      String // path ของรูป เช่น /uploads/xxx.jpg
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
}

model StatusLog {
  id        String       @id @default(cuid())
  status    TicketStatus // สถานะ ณ ตอนนั้น
  note      String?      // หมายเหตุเพิ่มเติม
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  createdAt DateTime     @default(now())
}

model Message {
  id        String   @id @default(cuid())
  text      String
  fromStaff Boolean  @default(false) // true = เจ้าหน้าที่, false = ลูกค้า

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String

  // ผู้ส่งอาจเป็น User ในระบบหรือไม่ก็ได้
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ===========================
// ประเมินความพึงพอใจลูกค้า (CSAT)
// ===========================
model SatisfactionReview {
  id            String   @id @default(cuid())
  rating        Int      // คะแนนความพึงพอใจรวม 1-5 ดาว
  speedRating   Int?     // ความรวดเร็วในการบริการ 1-5 ดาว
  serviceRating Int?     // คุณภาพงานซ่อมและความสุภาพช่าง 1-5 ดาว
  comment       String?  // ข้อเสนอแนะเพิ่มเติม
  tags          String[] @default([]) // แท็กคำชม เช่น ["ช่างสุภาพ", "ตรงเวลา"]
  customerName  String

  ticketId      String   @unique
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([rating])
}

// ===========================
// ระบบกลางเก็บประวัติแชทลูกค้า (ซิงค์จาก Chatbot Platform / LINE / Voicebot / Web)
// ===========================
model ChatConversation {
  id             String   @id @default(cuid())
  externalUserId String?  // User ID จาก Botnoi Chatbot Platform / LINE OA
  customerName   String
  customerPhone  String?
  channel        String   @default("CHATBOT") // CHATBOT, LINE, VOICEBOT, WEB
  status         String   @default("OPEN")    // OPEN, RESOLVED
  summary        String?  // สรุปหัวข้อที่ลูกค้าติดต่อเข้ามา

  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ticketId       String?
  ticket         Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       ChatLogMessage[]

  @@index([projectId, lastMessageAt])
  @@index([channel])
}

model ChatLogMessage {
  id             String           @id @default(cuid())
  sender         String           // CUSTOMER, BOT, STAFF
  senderName     String?
  text           String

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
